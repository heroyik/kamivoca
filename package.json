{
  "name": "kamivoca",
  "version": "3.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-offline-manifest.mjs",
    "start": "next start",
    "lint": "eslint",
    "delete:heroyik:cognites": "node scripts/delete-heroyik-cognites-and-sync.mjs",
    "data:normalize": "node scripts/normalize_vocab_pipeline.mjs",
    "sync:local:admin-edits": "node scripts/sync-admin-edits-to-local.mjs",
    "sync:local:admin-edits:finalize": "node scripts/sync-admin-edits-to-local.mjs --clear-remote-overrides",
    "sync:firestore:vocab": "node scripts/sync-firestore-vocab.mjs",
    "sync:firestore:full-voca": "node scripts/sync-full-voca.mjs",
    "data:refresh": "node scripts/regenerate_dataset_contexts.mjs && node scripts/transform_japanese_data.mjs && node scripts/sync-firestore-vocab.mjs && node scripts/sync-full-voca.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "firebase": "^12.9.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "^5"
  }
}
